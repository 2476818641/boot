#!/bin/sh
# 本 fork：默认只开一个 AP（5G 那个 QCN6024，非 DFS 信道性能最好），名字 imm / 密码 liuasd111
#
# 为什么不用上游的 WRT_SSID/WRT_WORD 就够了：
#   那两个变量是让 Settings.sh 去 sed 源码里的 BASE_SSID/BASE_WORD（只改默认值），
#   而"哪个 radio 默认开、哪个关"上游根本不管 —— 这里直接显式设置，避免依赖它的默认。
# AX6600 三个 radio（实测）：
#   radio0 = IPQ6018 5G @ch100（DFS 信道，默认就禁用）→ 保持禁用
#   radio1 = IPQ6018 2.4G @ch1                       → 关掉（需要时在 LuCI 里一键打开）
#   radio2 = QCN6024 5G @ch36（非 DFS，性能最好）      → 只留这个
uci -q set wireless.radio0.disabled='1'
uci -q set wireless.radio1.disabled='1'
uci -q set wireless.radio2.disabled='0'
for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)\.device='radio2'$/\1/p"); do
	uci -q set wireless.$s.disabled='0'
	uci -q set wireless.$s.ssid='imm'
	uci -q set wireless.$s.key='liuasd111'
	uci -q set wireless.$s.encryption='psk2+ccmp'
done
uci -q commit wireless
exit 0
